# URL de base du backend, injectée dans app.config.js (extra.apiBaseUrl).
# Point d'entrée UNIQUE = nginx du compose sur le port 8090 (sert l'API /api,
# les images /uploads et les QR). Le backend (8080) n'est PAS publié : passez par 8090.
#
# Device physique (recommandé) : http://<IP_LAN_DU_PC>:8090   (ex. http://192.168.1.187:8090)
#   -> téléphone et PC sur le MÊME Wi-Fi ; pare-feu Windows : autoriser le port 8090 entrant.
# Émulateur Android            : http://10.0.2.2:8090          (10.0.2.2 = hôte vu de l'émulateur)
# Émulateur iOS                : http://localhost:8090
API_BASE_URL=http://192.168.1.187:8090
