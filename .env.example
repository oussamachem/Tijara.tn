# ===========================================================================
# Variables d'environnement pour docker-compose (production).
# Copier en .env et renseigner les SECRETS (le .env n'est jamais committe).
# Les variables marquees REQUIS n'ont pas de valeur par defaut : compose refuse
# de demarrer si elles sont vides.
# ===========================================================================

# --- PostgreSQL ---
POSTGRES_DB=smart_boutique
POSTGRES_USER=smartboutique   # PROPRIETAIRE du schema (utilise par Flyway pour la DDL/les policies)
POSTGRES_PASSWORD=            # REQUIS : mot de passe de la base

# --- Role applicatif runtime (multi-tenant / RLS) ---
# L'app se connecte via ce role NON-SUPERUSER pour que la Row Level Security s'applique
# (un superuser la bypasserait). Le role est cree par la migration Flyway V9.
APP_DB_USERNAME=sb_app
APP_DB_PASSWORD=             # REQUIS : mot de passe du role runtime sb_app

# --- Backend (profil prod actif automatiquement en compose) ---
JWT_SECRET=                   # REQUIS : secret long et aleatoire (>= 32 caracteres)
JWT_EXPIRATION_MS=86400000
ADMIN_EMAIL=admin@smartboutique.com
ADMIN_PASSWORD=               # REQUIS : mot de passe de l'admin bootstrap
ADMIN_NAME=Administrateur

# SUPER_ADMIN plateforme (gere les boutiques / tenants).
SUPER_ADMIN_EMAIL=superadmin@smartboutique.com
SUPER_ADMIN_PASSWORD=        # REQUIS : mot de passe du super-admin plateforme

# Domaine(s) reel(s) autorise(s) par le CORS (separes par des virgules).
# En local via compose, le web est sur http://localhost:8090.
CORS_ALLOWED_ORIGINS=http://localhost:8090

# --- Stockage des images (S3) ---
# 'local' = disque/volume ; 's3' = objet-store S3 (MinIO auto-heberge par compose).
STORAGE=s3
S3_BUCKET=sb-images
S3_REGION=us-east-1
# Identifiants MinIO (= MINIO_ROOT_USER / MINIO_ROOT_PASSWORD). REQUIS (secret >= 8 car.).
# Pour passer au VRAI AWS S3 : mettre vos cles ici, laisser MinIO de cote et definir
# S3_ENDPOINT="" (vide) cote backend (compose : retirer S3_ENDPOINT=http://minio:9000).
S3_ACCESS_KEY=            # REQUIS
S3_SECRET_KEY=            # REQUIS (>= 8 caracteres)

# --- Keycloak (IAM / OIDC) ---
KEYCLOAK_DB_PASSWORD=     # REQUIS : mot de passe de la base dediee a Keycloak
KEYCLOAK_ADMIN=admin      # login de la console admin Keycloak
KEYCLOAK_ADMIN_PASSWORD=  # REQUIS : mot de passe de la console admin Keycloak
# URL PUBLIQUE de Keycloak (le NAVIGATEUR y est redirige pour le login SSO). Bakee dans les
# bundles front au build (docker compose build). Prod : https://auth.mondomaine.com
VITE_KEYCLOAK_URL=http://localhost:8081
# Backend : ISSUER = URL publique (= claim iss des tokens) ; JWKS = URL interne (reseau Docker).
# Laisser les defauts pour un stack 100% local ; en prod, ISSUER = meme URL publique que ci-dessus.
KEYCLOAK_ISSUER=http://localhost:8081/realms/smartboutique
KEYCLOAK_JWKS=http://keycloak:8080/realms/smartboutique/protocol/openid-connect/certs

# --- Notes ---
# Web ADMIN     : http://localhost:8090
# Marketplace   : http://localhost:8091
# Keycloak      : http://localhost:8081 (console admin + login SSO, theme « smartboutique »)
# PostgreSQL    : expose sur le port hote 5544 (interne : postgres:5432)
# Redis         : cache (maxmemory 500mb), interne (backend -> redis:6379)
# MinIO (S3)    : interne (backend -> minio:9000) ; console web sur http://localhost:9001
# Backend       : non expose sur l'hote (joignable via nginx : /api, /uploads)
